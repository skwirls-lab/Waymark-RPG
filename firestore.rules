rules_version = '2';

// Each phase opens exactly the access it needs. Every permission here has a
// test in tests/rules for both the allowed and the refused case.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Plans are written only by the server. No entitlements record means free.
    function plan() {
      let path = /databases/$(database)/documents/entitlements/$(request.auth.uid);
      return exists(path) ? get(path).data.plan : 'free';
    }

    // A free account may own one character and run one campaign. Paid plans
    // are "unlimited", which is 50. These numbers match rules/src/plans.ts.
    function slots() {
      return plan() == 'free' ? 1 : 50;
    }

    // What the owner chose to keep in use after a plan ended: a list of ids
    // in their own user record. Empty until they choose.
    function kept(uid, field) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) ? get(path).data.get(field, []) : [];
    }

    // Nothing is deleted when a plan ends. What is over the limit becomes
    // read-only: with no choice made the lowest slots stay in use, and a
    // choice counts only if it fits within the limit.
    function inUse(id, slot, field) {
      let limit = slots();
      let chosen = kept(request.auth.uid, field);
      return limit >= 50
        || (chosen.size() > 0 && chosen.size() <= limit ? id in chosen : slot <= limit);
    }

    // New things fill the lowest slots only, and not while a choice stands.
    function mayCreate(slot, field) {
      return slot >= 1 && slot <= slots()
        && (slots() >= 50 || kept(request.auth.uid, field).size() == 0);
    }

    match /users/{uid} {
      allow read: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt', 'keepCharacters', 'keepCampaigns'])
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('displayName', '').size() <= 80
        && request.resource.data.get('keepCharacters', []) is list
        && request.resource.data.get('keepCharacters', []).size() <= 50
        && request.resource.data.get('keepCampaigns', []) is list
        && request.resource.data.get('keepCampaigns', []).size() <= 50;
    }

    match /entitlements/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // How many AI requests an account has made this month. Counted by the server.
    match /usage/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    function isMember(campaignId) {
      return signedIn()
        && exists(/databases/$(database)/documents/campaigns/$(campaignId)/members/$(request.auth.uid));
    }

    // A player's choice of how the Warden may change their sheet.
    function controlOf(campaignId, uid) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)/members/$(uid)).data.control;
    }

    function isWarden(campaignId) {
      return signedIn()
        && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.wardenUid == request.auth.uid;
    }

    // The Warden may change a campaign only while it is in use under their
    // plan. A campaign over the limit can still be read by everyone in it.
    function wardenMayWrite(campaignId) {
      return isWarden(campaignId)
        && inUse(
          campaignId,
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.get('slot', 1),
          'keepCampaigns'
        );
    }

    // A character's id is its owner's uid and a slot number, so the number of
    // characters an account can hold cannot be exceeded from the browser.
    match /characters/{characterId} {
      function wellFormed() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerUid', 'slot', 'name', 'description', 'age', 'notes', 'sheet', 'undo', 'campaignId', 'createdAt', 'updatedAt'])
          && d.ownerUid == request.auth.uid
          && d.slot is int
          && characterId == request.auth.uid + '_' + string(d.slot)
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.sheet is map
          // A character may be placed only in a campaign its owner belongs to.
          && (!('campaignId' in d) || d.campaignId == null || isMember(d.campaignId));
      }

      function inMyCampaign() {
        return 'campaignId' in resource.data
          && resource.data.campaignId != null
          && isWarden(resource.data.campaignId);
      }

      // The owner sees the full sheet. So does the Warden of its campaign.
      // Other members see only the summary, below.
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || inMyCampaign());
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && wellFormed()
        && mayCreate(request.resource.data.slot, 'keepCharacters');
      allow update: if signedIn() && (
        (resource.data.ownerUid == request.auth.uid
          && wellFormed()
          && request.resource.data.slot == resource.data.slot
          // A character over the plan's limit is read-only.
          && inUse(characterId, resource.data.slot, 'keepCharacters'))
        // The Warden may change the sheet, and nothing else, of a player who
        // chose "directly". For a player who chose "ask me first" this is
        // refused, and the Warden must send a request instead.
        || (inMyCampaign()
          && wardenMayWrite(resource.data.campaignId)
          && controlOf(resource.data.campaignId, resource.data.ownerUid) == 'direct'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sheet', 'undo', 'name', 'updatedAt'])
          && request.resource.data.sheet is map
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80)
      );
    }

    // A world: a Warden's own content saved as a pack, to use in any campaign.
    match /users/{uid}/worlds/{worldId} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['name', 'content', 'creatures', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.content is map
        && request.resource.data.creatures is list;
    }

    // Campaigns are created, joined, left and deleted through Cloud Functions,
    // so that join codes cannot be read or guessed from the database.
    match /users/{uid}/memberships/{campaignId} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if isMember(campaignId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(campaignId);
        // A member may change only their own name and their permission choice.
        allow update: if isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['control', 'displayName'])
          && request.resource.data.control in ['direct', 'ask']
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 40;
        allow create, delete: if false;
      }

      // What every member may see of every character: name, HP, conditions.
      match /summaries/{characterId} {
        allow read: if isMember(campaignId);
        allow write: if false;
      }

      // What the Warden asks of a player: to accept a change, or to make a
      // roll. Only the Warden creates them; only the player answers them.
      match /requests/{requestId} {
        allow read: if isWarden(campaignId)
          || (signedIn() && resource.data.toUid == request.auth.uid);
        allow create: if wardenMayWrite(campaignId)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.kind in ['change', 'save', 'scar', 'strength-save']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300
          && exists(/databases/$(database)/documents/campaigns/$(campaignId)/members/$(request.resource.data.toUid));
        allow update: if signedIn()
          && resource.data.toUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'result', 'answeredAt'])
          && request.resource.data.status in ['accepted', 'declined', 'done'];
        allow delete: if isWarden(campaignId);
      }

      // The activity feed: what was rolled and what changed, for the group.
      // Entries are added, never altered.
      match /log/{entryId} {
        allow read: if isMember(campaignId);
        allow create: if isMember(campaignId)
          && request.resource.data.keys().hasOnly(['at', 'byUid', 'byName', 'text'])
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.at is number
          && request.resource.data.byName is string
          && request.resource.data.byName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      // An AI-run campaign's story so far: what was said, what the Warden
      // narrated, and what the rules decided. Written only by the server.
      match /turns/{turnId} {
        allow read: if isMember(campaignId);
        allow write: if false;
      }

      // Who has the campaign open right now.
      match /presence/{uid} {
        allow read: if isMember(campaignId);
        allow write: if isUser(uid) && isMember(campaignId)
          && request.resource.data.keys().hasOnly(['at', 'displayName'])
          && request.resource.data.at is number
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80;
        allow delete: if isUser(uid);
      }

      // The campaign record the whole table shares: the brief (the setting
      // and each session's mission) and the world's own Origins, Affinities,
      // Abilities and gear. The Warden writes; every member reads.
      match /shared/{docId} {
        allow read: if isMember(campaignId);
        allow write: if wardenMayWrite(campaignId) && docId in ['brief', 'content'];
      }

      // The Warden's own working papers: private notes, creatures, and the
      // fight in progress. No player can read these.
      match /private/{docId} {
        allow read: if isWarden(campaignId) && docId in ['notes', 'creatures', 'fight'];
        allow write: if wardenMayWrite(campaignId) && docId in ['notes', 'creatures', 'fight'];
      }

      // The timeline: what happened, in order. The server's clock stamps
      // each beat, so two devices agree on the order. A beat marked private
      // is the Warden's alone.
      match /beats/{beatId} {
        function beatOk() {
          let d = request.resource.data;
          return d.keys().hasOnly(['at', 'text', 'milestone', 'private', 'cardId', 'byUid'])
            && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
            && d.milestone is bool
            && d.private is bool
            && (d.cardId == null || d.cardId is string)
            && d.byUid == request.auth.uid;
        }
        allow read: if isWarden(campaignId)
          || (isMember(campaignId) && resource.data.private == false);
        allow create: if wardenMayWrite(campaignId) && beatOk()
          && request.resource.data.at == request.time;
        allow update: if wardenMayWrite(campaignId) && beatOk()
          && request.resource.data.at == resource.data.at;
        allow delete: if isWarden(campaignId);
      }

      // Cards for people, places, creatures, factions, items and threads.
      // A planned card is hidden from players until the Warden reveals it.
      match /cards/{cardId} {
        allow read: if isWarden(campaignId)
          || (isMember(campaignId) && resource.data.status != 'planned');
        allow create, update: if wardenMayWrite(campaignId)
          && request.resource.data.keys().hasOnly(['kind', 'name', 'text', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['person', 'place', 'creature', 'faction', 'item', 'thread']
          && request.resource.data.status in ['planned', 'met', 'changed', 'gone']
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow delete: if isWarden(campaignId);
      }

      // What the Warden knows about a card and the players do not.
      match /cardNotes/{cardId} {
        allow read, delete: if isWarden(campaignId);
        allow create, update: if wardenMayWrite(campaignId);
      }

      // Characters the Warden runs for players without a device. Six at most:
      // their ids are w1 to w6.
      match /characters/{characterId} {
        allow read, delete: if isWarden(campaignId);
        allow create, update: if wardenMayWrite(campaignId)
          && characterId.matches('^w[1-6]$')
          && request.resource.data.keys().hasOnly(['name', 'description', 'notes', 'sheet', 'undo', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.sheet is map;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

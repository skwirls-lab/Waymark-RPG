{
  "name": "waymark",
  "private": true,
  "type": "module",
  "workspaces": [
    "site",
    "app"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json",
    "test:unit": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:rules": "vitest run --config tests/rules/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:emulators": "firebase emulators:exec --project demo-waymark --only auth,firestore \"npm run test:rules && npm run test:e2e\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:emulators"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "^4.10.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "firebase-tools": "^15.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
